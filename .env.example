# =============================================================================
# .env.example  —  copy to `.env` (which is git-ignored) and fill in.
# =============================================================================
# RULES
#   * `.env` is the ONLY place real secrets live. Never put credentials in any
#     .toml / .yaml / .json config file, and never commit `.env`.
#   * Nothing here is required to run the tests or a pilot on local files —
#     the offline paths work with no credentials at all.
#   * Modules add their own sections as marked blocks above `modules:insert`
#     (the container module adds PostGIS and the Remote Control box).
# =============================================================================

# --- ArcGIS Online (AGOL) — OAuth 2.0 client-credentials (app auth) -----------
# Register an OAuth app in your AGOL org -> get a Client ID + Client Secret.
# The token manager (src/agol/token_manager.py) exchanges these for a
# short-lived access token and auto-refreshes it before expiry. Preferred for
# headless/scheduled runs — no interactive login, no stored password.
AGOL_CLIENT_ID=your-client-id-here
AGOL_CLIENT_SECRET=your-client-secret-here
AGOL_PORTAL_URL=https://www.arcgis.com
# Optional: your org URL, e.g. https://morphum.maps.arcgis.com
AGOL_ORG_URL=

# --- ArcGIS Online — alternative auth (pick ONE approach) --------------------
# A pre-minted API key / long-lived access token (simplest, coarser scope):
# AGOL_API_KEY=
# A pre-supplied token (e.g. from another process):
# AGOL_TOKEN=

# --- Basemap / third-party keys ----------------------------------------------
# LINZ Data Service key for NZ aerial basemaps (referenced by name from config).
LINZ_API_KEY=

# --- Playwright / PDF export (optional overrides) ----------------------------
# PLAYWRIGHT_CHROMIUM_PATH=
# PLAYWRIGHT_CHROMIUM_CHANNEL=

# modules:insert
